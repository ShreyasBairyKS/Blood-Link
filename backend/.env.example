ENVIRONMENT=development

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://bloodlink:bloodlink@localhost:5432/bloodlink
DATABASE_URL_SYNC=postgresql+psycopg2://bloodlink:bloodlink@localhost:5432/bloodlink

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

OTP_EXPIRE_MINUTES=5
OTP_PROVIDER=console

# JSON array — origins allowed to call the API from a browser (mobile web preview, hospital console)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
